generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

model Configuration {
  id                 Int       @id @default(1)
  jwtSecret          String?   @db.VarChar(256)
  // Legacy : la rotation du JWT_SECRET a été retirée (secret géré via l'env, stable).
  // Colonnes conservées inertes pour éviter un DROP destructif en prod ; plus aucun code ne les lit/écrit.
  jwtSecretNext      String?   @db.VarChar(256)
  jwtSecretExpiresAt DateTime?
  clientId42         String    @default("") @db.Text
  clientSecret42     String    @default("") @db.Text
  clientSecret42Next String?   @db.Text
  credentialsInvalidSince DateTime?
  // Inerte depuis le retrait de la voie de bootstrap /setup localhost : le bootstrap
  // owner passe par /admin (token console en mémoire + passkey). Purgée à NULL par la
  // migration `retire_setup_token` ; plus aucun code ne la lit/écrit.
  setupToken         String?   @db.VarChar(128)
  isConfigured       Boolean   @default(false)
  updatedAt          DateTime  @updatedAt

  @@map("configuration")
}

model UserSimulation {
  id                    Int      @id @default(autoincrement())
  userId42              Int      @unique
  login                 String   @db.VarChar(64)
  firstName             String?  @db.VarChar(64)
  lastName              String?  @db.VarChar(64)
  imageUrl              String?  @db.VarChar(512)
  // Campus principal, relevé à la connexion (la réponse /v2/me du callback OAuth
  // le contient déjà) : évite un appel dédié à l'API 42 juste pour le connaître.
  // Sert à n'afficher sur le Holy Graph que les projets proposés sur ce campus.
  campusId              Int?
  isPublic              Boolean?
  // Dernier passage dans l'application, rafraîchi au plus une fois par heure.
  // Sert UNIQUEMENT aux statistiques agrégées (combien de personnes utilisent
  // l'app sur une journée, une semaine…) : rien de nominatif n'en sort.
  lastSeenAt            DateTime?
  hasSeenTour           Boolean  @default(false)
  lastSeenChangelog     String?  @db.VarChar(32) // version du dernier changelog acquitté (null = jamais)
  simulatedSubProjects  Json?    // Record<string, string[]>
  customProjects        Json?    // SimulatorProject[]
  manualExperiences     Json?    // ProfessionalExperience[]
  apiExpPercentages     Json?    // Record<number, number>
  calendarData          Json?    // CalendarData { placedProjects, dateRange, alternanceDays }
  updatedAt             DateTime @updatedAt
  createdAt             DateTime @default(now())

  simulatedProjects SimulatedProject[]

  @@index([lastSeenAt])
  @@map("user_simulation")
}

model SimulatedProject {
  id              Int      @id @default(autoincrement())
  userId42        Int
  projectId       String   @db.VarChar(128)
  percentage      Int      @default(100)
  coalitionBoost  Boolean  @default(false)
  note            String?  @db.Text
  // « J'ai déjà ma team » : l'utilisateur reste dans la liste des personnes qui
  // ont simulé le projet, mais signale où en est son groupe.
  hasTeam         Boolean  @default(false)
  // Nombre de personnes déjà dans le groupe. Comparé à la taille maximale du
  // projet, il dit si le groupe est complet ou s'il reste une place — un groupe
  // incomplet reste contactable.
  teamSize        Int?
  updatedAt       DateTime @updatedAt
  createdAt       DateTime @default(now())

  userSimulation  UserSimulation @relation(fields: [userId42], references: [userId42], onDelete: Cascade)

  @@unique([userId42, projectId])
  @@index([projectId])
  @@map("simulated_project")
}

// Instantané des données 42 d'un utilisateur (dernier fetch réussi).
// Servi tel quel en usage normal : aucune requête vers l'API 42 tant que
// l'utilisateur ne déclenche pas explicitement un refresh. `fetchedAt` sert
// à la fois d'horodatage d'affichage et de base au cooldown anti-spam.
model UserData42 {
  userId42     Int      @id
  level        Float    @default(0)
  eventsCount  Int      @default(0)
  projects     Json?    // string[] : noms des projets validés
  allProjects  Json?    // Project42[]
  allCursus    Json?    // CursusUser[]
  allEvents    Json?    // Event42[]
  fetchedAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@map("user_data_42")
}

// Tokens OAuth 42 stockés côté serveur (chiffrés AES-256-GCM, clé dérivée de
// JWT_SECRET). Le token d'accès 42 expire en ~2h : on le rafraîchit via le
// refresh_token pour que la session applicative (JWT 7j) ne soit plus couplée
// au token 42 (sinon tout refresh échoue en 401 après 2h).
model UserToken42 {
  userId42     Int      @id
  accessToken  String   @db.Text // chiffré
  refreshToken String   @db.Text // chiffré
  expiresAt    DateTime          // expiration de l'access token 42
  updatedAt    DateTime @updatedAt

  @@map("user_token_42")
}

// Cache PARTAGÉ des données de référence 42 (catalogue d'un cursus, layout
// officiel du Holy Graph). Ces données sont les mêmes pour tout le monde et ne
// bougent quasiment jamais : on les garde un mois et on les persiste en base
// pour qu'un redémarrage du backend ne relance pas des dizaines de requêtes
// vers l'API 42. Seul un refresh global déclenché par l'admin les renouvelle
// avant expiration.
model Api42Cache {
  key       String   @id @db.VarChar(64) // 'project_data' | 'cursus_projects:21'
  payload   Json
  fetchedAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("api42_cache")
}

// État du refresh global déclenché par l'admin : sert à interdire un second
// lancement pendant qu'un est en cours, et à afficher la dernière exécution.
model GlobalRefresh {
  id             Int       @id @default(1)
  startedAt      DateTime?
  finishedAt     DateTime?
  startedBy      String?   @db.VarChar(128)
  usersTotal     Int       @default(0)
  usersDone      Int       @default(0)
  lastError      String?   @db.Text

  @@map("global_refresh")
}

// ===== Authentification admin autonome (découplée d'OAuth 42) =====
// Permet à l'owner de gérer l'application (secrets 42, méthodes d'auth, délégués)
// même si l'OAuth 42 est mort. L'owner s'authentifie par passkey (WebAuthn) ; un
// token console affiché dans les logs au boot sert de bootstrap/recovery. Aucune
// donnée ici n'est un secret (clé PUBLIQUE WebAuthn, login délégué, journal) → pas
// de chiffrement nécessaire.

model AdminCredential {
  id           Int       @id @default(autoincrement())
  credentialId String    @unique @db.VarChar(512) // identifiant WebAuthn (base64url)
  publicKey    String    @db.Text                 // clé publique COSE (base64url)
  counter      Int       @default(0)              // compteur anti-clonage (0 pour les passkeys synchronisées)
  transports   String?   @db.VarChar(255)         // transports WebAuthn (csv)
  label        String?   @db.VarChar(128)         // libellé lisible choisi par l'owner
  createdAt    DateTime  @default(now())
  lastUsedAt   DateTime?

  @@map("admin_credential")
}

model AdminDelegate {
  id        Int      @id @default(autoincrement())
  login42   String   @unique @db.VarChar(64) // login 42 autorisé à éditer les SEULS secrets 42
  createdAt DateTime @default(now())

  @@map("admin_delegate")
}

model AdminAuditEvent {
  id     Int      @id @default(autoincrement())
  at     DateTime @default(now())
  actor  String   @db.VarChar(128) // 'console' | 'owner:<credId>' | login 42
  action String   @db.VarChar(64)  // admin_login | secret_updated | delegate_added | ...
  detail String?  @db.Text

  @@index([at])
  @@map("admin_audit_event")
}
