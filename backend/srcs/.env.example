# Server
PORT=7000

# 42 OAuth
CLIENT_ID_42=
CLIENT_SECRET_42=

# JWT Secret (generate with: openssl rand -base64 32)
JWT_SECRET=your_jwt_secret_here

# Administration : aucune variable requise. L'owner s'authentifie avec le « token
# console » affiché dans les logs au démarrage — seule voie owner depuis le retrait
# des passkeys. Les admins délégués entrent avec leur session 42 et n'ont que les
# zones qu'on leur coche, depuis le panneau /admin.

# Rate Limiting
RATE_LIMIT_MAX=100
RATE_LIMIT_TIMEWINDOW=60000