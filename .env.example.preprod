# ========================================
# CalculatorGCC — PRÉ-PRODUCTION
# ========================================
# Instance de recette, isolée de la prod. Elle peut cloner la base de prod au
# démarrage pour travailler sur des données réalistes.
#
# ATTENTION : la pré-prod doit avoir SES PROPRES credentials 42 (une seconde
# application sur l'intra), sinon les deux instances se partagent le même
# client_id et le même redirect_uri.

NODE_PROJET=production
ENABLE_SSL=true

APP_DOMAIN=https://preprod.exemple.fr
LOCAL_SETUP_PORT=3001

BACKEND_PATH=/app
FRONTEND_PATH=/app

# ---------- Base de données ----------
DB_ROOT_PASSWORD=change-moi
DB_NAME=calculatorgcc
DB_USER=calculatorgcc_user
DB_PASSWORD=change-moi

# Chemin persistant DISTINCT de celui de la prod : sans ça, les deux instances
# écrivent dans le même volume.
MARIADB_DATA_PATH=/data/calculatorgcc-preprod/mariadb
DB_SHARED_ALIAS=calculatorgcc-preprod-db

# ---------- Clonage depuis la prod ----------
# Copie la base de prod dans celle-ci au démarrage. En lecture seule côté prod.
CLONE_FROM_PROD_ENABLED=true
REQUIRE_CONFIGURED_DB=false
PROD_DB_HOST=calculatorgcc-prod-db
PROD_DB_PORT=3306
PROD_DB_NAME=calculatorgcc
PROD_DB_USER=calculatorgcc_user
PROD_DB_PASSWORD=change-moi

# Credentials 42 propres à la pré-prod. Renseignés ici, ils PRIMENT sur ceux
# de la base clonée — c'est justement ce qu'on veut : sans eux, la pré-prod
# utiliserait les credentials de production copiés avec la base.
CLIENT_ID_42=
CLIENT_SECRET_42=

# ---------- Mode miroir ----------
MIRROR_API_URL=
