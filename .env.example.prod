# ========================================
# CalculatorGCC — PRODUCTION
# ========================================
# Les credentials 42 ne se mettent PAS ici : ils se saisissent depuis /admin et
# sont chiffrés en base avec une clé dérivée du JWT_SECRET.

NODE_PROJET=production
ENABLE_SSL=true

# Domaine public. <APP_DOMAIN>/api/auth/callback doit être l'unique
# redirect_uri déclarée dans l'application 42.
APP_DOMAIN=https://rncp.theomouty.fr

# Port loopback pour la configuration initiale (accessible via tunnel SSH).
LOCAL_SETUP_PORT=3000

BACKEND_PATH=/app
FRONTEND_PATH=/app

# ---------- Base de données ----------
# openssl rand -base64 32
DB_ROOT_PASSWORD=change-moi
DB_NAME=calculatorgcc
DB_USER=calculatorgcc_user
DB_PASSWORD=change-moi

MARIADB_DATA_PATH=/data/calculatorgcc/mariadb
DB_SHARED_ALIAS=calculatorgcc-prod-db

# Jamais de clonage en production.
CLONE_FROM_PROD_ENABLED=false
REQUIRE_CONFIGURED_DB=true

# ---------- Mode miroir ----------
# Laisser VIDE sur l'instance principale : c'est elle qui détient les données.
# Sur une instance miroir, renseigner l'API principale (ex. https://rncp.theomouty.fr/api)
# — ou mieux, la régler à chaud depuis /admin. Voir docs/instance-miroir.md.
MIRROR_API_URL=
