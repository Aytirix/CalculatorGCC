# ========================================
# CalculatorGCC — DÉVELOPPEMENT (poste local)
# ========================================
# Copier en `.env` à la racine, puis `make` / `docker compose -f docker-compose.dev.yml up`.
# Les credentials 42 ne se mettent PAS ici : ils se saisissent une fois depuis
# /admin (token console affiché dans les logs au démarrage) et sont ensuite
# chiffrés en base.

NODE_PROJET=dev
ENABLE_SSL=false

# Domaine de l'application. Il sert aussi de redirect_uri OAuth 42 :
# <APP_DOMAIN>/api/auth/callback doit être déclaré dans l'application 42.
APP_DOMAIN=http://localhost:3000
LOCAL_SETUP_PORT=3000

BACKEND_PATH=/app
FRONTEND_PATH=/app

# ---------- Base de données ----------
# En dev, laisser les mots de passe vides les fait générer aléatoirement.
DB_ROOT_PASSWORD=
DB_NAME=calculatorgcc
DB_USER=calculatorgcc_user
DB_PASSWORD=

# ---------- Mode miroir ----------
# Vide en dev. Voir docs/instance-miroir.md.
MIRROR_API_URL=
